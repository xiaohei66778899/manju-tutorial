# DeepSeek V3 API(LLM 摘要 · 可选)
# 注册:https://platform.deepseek.com/
# 免费额度足够每日 50-200 条摘要

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 每日 LLM 调用上限(默认 200,根据额度调整)
DAILY_LLM_LIMIT=200

# 启用 LLM 抓取:node fetch.js --with-llm
# 启用 LLM cron:   node cron.js with-llm
